# Ethereum mainnet RPC with archive eth_call support
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Etherscan API key (used to list the holder's spUSDS transfers)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY

# Optional — these default to Osero's ALM Proxy and SparkLend spUSDS
# HOLDER_ADDRESS=0x6d370e359e9cbd0fd35bb38faf705d84238cb884
# ATOKEN_ADDRESS=0xc02ab1a5eaa8d1b114ef786d9bde108cd4364359
# CHAIN_ID=1
# LIVE_CACHE_TTL=30

# Railway injects PORT automatically
# PORT=3000
